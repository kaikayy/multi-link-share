{
  "manifest_version": 3,
  "default_locale": "en",
  "name": "__MSG_appName__",
  "short_name": "Tab Share",
  "version": "1.0.0.11",
  "version_name": "1.0.0-beta.11",
  "description": "__MSG_appDescription__",
  "author": "Tab Share contributors",
  "homepage_url": "https://github.com/kaikayy/multi-link-share",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Tab Share",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://kaikayy.github.io/multi-link-share/*"],
      "js": [
        "src/lib/i18n.js",
        "src/lib/lzstring.min.js",
        "src/lib/share-codec.js",
        "src/content/import-banner.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["tabs", "storage", "scripting", "tabGroups"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "minimum_chrome_version": "116"
}
