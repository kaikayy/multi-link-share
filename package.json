{
  "name": "tab-share-ext",
  "version": "1.0.0-beta.5",
  "description": "Bundle a group of tabs (current window, a tab group, or pasted links) into one link that opens as a slideshow — no account, no server, and the recipient needs no extension.",
  "license": "AGPL-3.0-only",
  "private": true,
  "scripts": {
    "test": "node scripts/selftest.mjs",
    "sync": "node scripts/sync-shared.mjs",
    "icons": "node scripts/make-icons.mjs",
    "build": "node scripts/build.mjs",
    "build:local": "VIEWER_BASE=http://localhost:8777/ node scripts/build.mjs",
    "zip:source": "node scripts/zip-source.mjs",
    "serve:viewer": "node scripts/serve-viewer.mjs",
    "serve:local": "node scripts/serve-local.mjs",
    "dev": "node scripts/serve-dev.mjs",
    "lint:ext": "web-ext lint --source-dir dist/firefox"
  },
  "devDependencies": {},
  "optionalDevDependencies": {
    "web-ext": "^8.0.0"
  }
}
